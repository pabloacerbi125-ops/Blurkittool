<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="blurkit.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="2021"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="reglas" custom_title="0" dock_id="7" table="4,6:mainreglas"/><table title="users" custom_title="0" dock_id="6" table="4,5:mainusers"/><table title="modalidades" custom_title="0" dock_id="5" table="4,11:mainmodalidades"/><table title="reglas" custom_title="0" dock_id="4" table="4,6:mainreglas"/><table title="reglas" custom_title="0" dock_id="3" table="4,6:mainreglas"/><table title="login_attempts" custom_title="0" dock_id="1" table="4,14:mainlogin_attempts"/><table title="reglas" custom_title="0" dock_id="2" table="4,6:mainreglas"/><table title="modalidades" custom_title="0" dock_id="8" table="4,11:mainmodalidades"/><dock_state state=""/><default_encoding codec=""/><browse_table_settings><table schema="main" name="modalidades" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="29"/><column index="2" value="300"/><column index="3" value="300"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="reglas" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="29"/><column index="2" value="300"/><column index="3" value="86"/><column index="4" value="41"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="users" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="29"/><column index="2" value="109"/><column index="3" value="187"/><column index="4" value="300"/><column index="5" value="78"/><column index="6" value="58"/><column index="7" value="210"/><column index="8" value="210"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">INSERT INTO reglas (descripcion, modalidad_id) VALUES
('〔9〕PROHIBIDO Uso de Skins Obscenas: Skins donde se vean partes íntimas y/o otras.', 14),
('〔10〕PROHIBIDO Uso de Multicuentas: Usar multicuentas para beneficios propios, tener conectadas 2 cuentas al mismo tiempo en la modalidad o 2 cuentas conectadas al mismo tiempo en diferentes modalidades, para obtener kits, recompensas, llaves, dinero, protecciones, farmeo Afk, granjas Afk, etc.\nSi un familiar juega desde la misma IP, deberán abrir ticket para demostrar que son usuarios distintos y así podrán jugar ambos en el servidor.', 14),
('〔11〕PROHIBIDO Suplantación de identidad, es decir, hacerse pasar por otro usuario, sea mediante /nick (Rangos Rey/Reyna/Emperador/Patreon), apodos en discord y en el servidor.', 14),
('〔12〕PROHIBIDO Tener un apodo, nick y/o nombre de clan ofensivo, obsceno o inapropiado.', 14),
('〔13〕PROHIBIDO Comercio de ítems por dinero real: Te doy 50USD por tu picasso Navidad, eso es ilegal y llevará a una sanción grave. Aquí puedes ver el anuncio dado: ⁠❰📣❱▹anuncios⁠.', 14),
('〔14〕PROHIBIDO El abuso de bugs, animaciones o mecánicas con fallas dentro del servidor: Abusar de un bug que hay en el servidor y aún así no reportarlo y abusar masivamente de él, es ilegal y sancionable gravemente.', 14),
('〔15〕PROHIBIDO El TpKill, SpawnKill y WarpKill.\nMatar a un jugador mediante el comando /tpa, /is warp, /pwarp nick cuando le aceptas el tp /tpaccept.\nIncluyendo el hecho de hacerlo mediante trampas.', 14),
('〔16〕PROHIBIDO El grifeo en cualquier isla, protección en la que tengas permisos, es decir, romper, destruir, crear torres de agua, lava, u otros, en zonas de otros jugadores.', 14),
('〔17〕PROHIBIDO Colocar [PRIVATE] en cofres, hornos, bloques, spawners, que no sean de tu propiedad.', 14),
('〔18〕PROHIBIDO Realizar construcciones obscenas.', 14),
('〔19〕PROHIBIDO pedir ítems, rangos u otros a miembros del staff (excesivamente o con la finalidad de molestar).', 14);</sql><current_tab id="0"/></tab_sql></sqlb_project>
